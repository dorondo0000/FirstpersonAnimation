# ======================================================================
# Firstperson Animation — fpa:pistol
#
# needs: Skript 2.13+   (set item cooldown of ... for ...)
#        SkBee  3.12+   (item model of ... / custom nbt of ...)
#
# The pack does everything client side. The server only sets:
#   1. minecraft:item_model   -> "fpa:pistol"
#   2. minecraft:custom_data  -> the animation name under "fpa"
#   3. a vanilla item cooldown -> the playback head
# Any item type works; the model replaces its appearance entirely.
# ======================================================================

options:
	model: fpa:pistol
	anim: fpa
	bar: fpa_bar
	base: stick   # cosmetic only — the item model replaces it

# --- build ------------------------------------------------------------

function fpa_pistol_item() :: item:
	set {_i} to {@base}
	set item model of {_i} to "{@model}"
	return {_i}

function fpa_pistol_give(p: player):
	give fpa_pistol_item() to {_p}

# --- cooldown display on/off -------------------------------------------
#
# The pack draws its own bar in the hotbar, off unless custom_data carries
# "fpa_bar". The model checks it with a real predicate, so the match is PARTIAL —
# anything else you keep in custom_data is left alone.
#
# Vanilla still draws its own white overlay on top. Removing that needs the
# optional core-shader sub-pack (tools/make_cooldown_hider.ps1), which is a
# separate pack because it has to live under assets/minecraft.

function fpa_pistol_bar(i: item, show: boolean) :: item:
	if {_show} is true:
		set byte tag "{@bar}" of custom nbt of {_i} to 1
	else:
		delete byte tag "{@bar}" of custom nbt of {_i}
	return {_i}

# --- play -------------------------------------------------------------
#
# The cooldown IS the playback head: its length sets both the speed and how
# many poses the client can resolve (ticks + 1, hard ceiling 20/sec).

function fpa_pistol_fire(p: player):
	set {_i} to {_p}'s tool
	set string tag "{@anim}" of custom nbt of {_i} to "fire"
	set {_p}'s tool to {_i}
	set item cooldown of {_i} for {_p} to 8 ticks   # 9 baked frames

function fpa_pistol_reload(p: player):
	set {_i} to {_p}'s tool
	set string tag "{@anim}" of custom nbt of {_i} to "reload"
	set {_p}'s tool to {_i}
	set item cooldown of {_i} for {_p} to 28 ticks   # 29 baked frames

# --- example wiring ---------------------------------------------------

command /fpa_pistol:
	trigger:
		fpa_pistol_give(player)

on right click:
	item model of player's tool is "{@model}"
	player doesn't have an item cooldown on player's tool
	fpa_pistol_fire(player)
